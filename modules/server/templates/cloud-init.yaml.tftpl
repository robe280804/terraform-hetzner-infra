#cloud-config
# Hardening base: gira solo al primo avvio del server.
# Verifica dopo il boot: cat /var/log/cloud-init-hardening.done

hostname: ${hostname}
fqdn: ${hostname}
prefer_fqdn_over_hostname: false
timezone: ${timezone}
locale: en_US.UTF-8

users:
  - name: ${admin_user}
    groups: [sudo]
    shell: /bin/bash
    # Password bloccata: sudo senza password, accesso solo con chiave SSH.
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
%{ for key in admin_ssh_public_keys ~}
      - ${key}
%{ endfor ~}

disable_root: true
ssh_pwauth: false

package_update: true
package_upgrade: true
packages:
  - unattended-upgrades
  - fail2ban
  - ufw

write_files:
  # Drop-in: sopravvive agli aggiornamenti del pacchetto openssh-server.
  - path: /etc/ssh/sshd_config.d/10-hardening.conf
    permissions: "0644"
    owner: root:root
    content: |
      # Managed by Terraform / cloud-init: non modificare a mano.
      PubkeyAuthentication yes
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitEmptyPasswords no
      UsePAM yes

      PermitRootLogin no
      AllowUsers ${admin_user}

      MaxAuthTries 3
      MaxSessions 5
      LoginGraceTime 30

      X11Forwarding no
      AllowAgentForwarding no
      AllowTcpForwarding no
      PermitTunnel no

      ClientAliveInterval 300
      ClientAliveCountMax 2
%{ if login_banner != "" ~}

      Banner /etc/issue.net
%{ endif ~}

  # Backend systemd obbligatorio su Ubuntu 24.04: /var/log/auth.log non esiste.
  - path: /etc/fail2ban/jail.local
    permissions: "0644"
    owner: root:root
    content: |
      # Managed by Terraform / cloud-init
      [DEFAULT]
      backend  = systemd
      bantime  = ${fail2ban_bantime}
      findtime = ${fail2ban_findtime}
      maxretry = ${fail2ban_maxretry}
      # Gli IP ammessi su SSH non vengono mai bannati: evita di chiudersi fuori.
      ignoreip = 127.0.0.1/8 ::1 ${fail2ban_ignoreip}

      [sshd]
      enabled = true
      port    = ssh
      mode    = aggressive

  - path: /etc/sysctl.d/99-hardening.conf
    permissions: "0644"
    owner: root:root
    content: |
      # Managed by Terraform / cloud-init
      net.ipv4.conf.all.rp_filter = 1
      net.ipv4.conf.default.rp_filter = 1
      net.ipv4.conf.all.accept_source_route = 0
      net.ipv4.conf.default.accept_source_route = 0
      net.ipv6.conf.all.accept_source_route = 0
      net.ipv4.conf.all.accept_redirects = 0
      net.ipv4.conf.default.accept_redirects = 0
      net.ipv4.conf.all.secure_redirects = 0
      net.ipv6.conf.all.accept_redirects = 0
      net.ipv4.conf.all.send_redirects = 0
      net.ipv4.conf.default.send_redirects = 0
      net.ipv4.icmp_echo_ignore_broadcasts = 1
      net.ipv4.icmp_ignore_bogus_error_responses = 1
      net.ipv4.tcp_syncookies = 1
      net.ipv4.tcp_max_syn_backlog = 2048
      net.ipv4.tcp_synack_retries = 2
      net.ipv4.conf.all.log_martians = 1

      kernel.dmesg_restrict = 1
      kernel.kptr_restrict = 2
      kernel.yama.ptrace_scope = 1
      fs.suid_dumpable = 0
      fs.protected_symlinks = 1
      fs.protected_hardlinks = 1

      # IP forwarding non impostato: spento di default. Docker gira rootless
      # (rete in user-mode) e non ne ha bisogno.

  - path: /etc/systemd/journald.conf.d/99-limits.conf
    permissions: "0644"
    owner: root:root
    content: |
      [Journal]
      SystemMaxUse=${journald_max_use}
      SystemMaxFileSize=100M
      MaxRetentionSec=1month
      Storage=persistent

  - path: /etc/apt/apt.conf.d/20auto-upgrades
    permissions: "0644"
    owner: root:root
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
      APT::Periodic::AutocleanInterval "7";

  # Solo aggiornamenti di sicurezza, mai reboot automatico.
  - path: /etc/apt/apt.conf.d/52unattended-upgrades-local
    permissions: "0644"
    owner: root:root
    content: |
      Unattended-Upgrade::Allowed-Origins {
              "$${distro_id}:$${distro_codename}-security";
              "$${distro_id}ESMApps:$${distro_codename}-apps-security";
              "$${distro_id}ESM:$${distro_codename}-infra-security";
      };
      Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
      Unattended-Upgrade::Remove-Unused-Dependencies "true";
      # Un riavvio si decide, non si subisce. Serve? ls /var/run/reboot-required
      Unattended-Upgrade::Automatic-Reboot "false";
%{ if login_banner != "" ~}

  # Banner legale pre-autenticazione. Sovrascrive il default di Ubuntu, che
  # espone versione del sistema: informazione utile solo a chi fa ricognizione.
  - path: /etc/issue
    permissions: "0644"
    owner: root:root
    content: |
      ${login_banner}

  - path: /etc/issue.net
    permissions: "0644"
    owner: root:root
    content: |
      ${login_banner}
%{ endif ~}

runcmd:
  # ufw come seconda barriera, dietro al firewall Hetzner.
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw limit 22/tcp comment 'SSH (rate limited)'
%{ if open_http ~}
  - ufw allow 80/tcp comment 'HTTP'
  - ufw allow 443/tcp comment 'HTTPS'
%{ endif ~}
  - ufw --force enable

  - sysctl --system
  - systemctl restart systemd-journald
  - systemctl enable --now fail2ban

  # `sshd -t` prima del restart: con un errore nel drop-in sshd resta sulla
  # config precedente e il server rimane raggiungibile. `&&` perché runcmd
  # non si ferma al primo errore: due righe separate riavvierebbero comunque.
  - sshd -t && systemctl restart ssh

  - |
    {
      date -u +"%Y-%m-%dT%H:%M:%SZ"
      echo "server: ${hostname}"
      echo "admin_user: ${admin_user}"
      echo "fail2ban: $(systemctl is-active fail2ban)"
      echo "ufw: $(ufw status | head -n1)"
    } > /var/log/cloud-init-hardening.done

final_message: "Bootstrap completato in $UPTIME secondi. Accedi con: ssh ${admin_user}@<ip>"
